# Server
NODE_ENV=development
PORT=5000
API_BASE_PATH=/api

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=collabnest
DB_SSL=false

# JWT — tightened to match the security doc (15 min access / 7 day
# rotating refresh). No PRD conflict, so applied directly.
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER_ME=30d

# Cloudinary (profile pictures / project images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Security doc: auth endpoints (register/login/refresh) limited to
# 10 requests/minute per IP.
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
# PRD/auth doc: max 5 failed login attempts per minute per IP.
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=5
# Security doc Module 6: search endpoints limited to 60 requests/minute.
SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX=60

# Frontend base URL (used to build shareable public profile links)
FRONTEND_PUBLIC_PROFILE_BASE_URL=http://localhost:5173/profile

# Paystack — NGN only. Foreign-currency payers are converted automatically
# by their card network against the fixed NGN amount; no custom FX API is
# used (client decision — see backend/README.md "Payments" section).
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Where Paystack redirects the browser after checkout (frontend route that
# reads ?reference= from the URL and calls GET /billing/verify).
FRONTEND_BILLING_CALLBACK_URL=http://localhost:5173/billing/callback
